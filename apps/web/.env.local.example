# GrowthOS local POC — no cloud database required

USE_LOCAL_DB=true

# Auth (optional for local dev)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Encryption key for stored OAuth tokens + tenant API keys (AES-256-GCM).
# REQUIRED in production. Optional in local dev (uses a clearly-marked
# fallback). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Cloud database (optional)
# USE_LOCAL_DB=false
# DATABASE_URL=postgresql://...

# Meta (optional)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=growthos-dev-verify

# TikTok (optional)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# AI copy + vision + copilot (optional)
ANTHROPIC_API_KEY=

# Post Studio Phase 2 (all optional — features degrade gracefully)
# OpenAI image generation
OPENAI_API_KEY=
# ElevenLabs voiceover
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Canva Connect (Edit in Canva)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
