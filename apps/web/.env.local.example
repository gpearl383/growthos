# GrowthOS local POC — no cloud database required

USE_LOCAL_DB=true

# Auth (optional for local dev)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Encryption key for stored OAuth tokens + tenant API keys (AES-256-GCM).
# REQUIRED in production. Optional in local dev (uses a clearly-marked
# fallback). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Cloud database (optional)
# USE_LOCAL_DB=false
# DATABASE_URL=postgresql://...

# Media storage (optional — local dev defaults to filesystem at .data/uploads).
# REQUIRED in production (Vercel serverless functions can't write to disk).
# Provision via: pnpm dlx vercel blob create-store <name> --access public
# Auto-provisioned as BLOB_READ_WRITE_TOKEN when you link a Blob store to the
# Vercel project — no manual copy/paste needed in production.
BLOB_READ_WRITE_TOKEN=

# Meta (optional)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=growthos-dev-verify

# TikTok (optional)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# AI copy + vision + copilot (optional)
ANTHROPIC_API_KEY=

# Post Studio Phase 2 (all optional — features degrade gracefully)
# OpenAI image generation
OPENAI_API_KEY=
# ElevenLabs voiceover
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Canva Connect (Edit in Canva)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
